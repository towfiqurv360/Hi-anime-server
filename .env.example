# Render sets PORT automatically. Do not hard-code a Render port in the code.
PORT=10000

# Your frontend origin. For multiple origins, separate them with commas.
# Local development can use *.
ALLOWED_ORIGINS=http://localhost:3000

# Upstream source used by the scraper.
HIANIME_BASE_URL=https://aniwatchtv.to
HIANIME_BASE_URL_2=https://aniwatchtv.to

# Optional logging controls.
ENABLE_LOGGING=false
LOG_LEVEL=INFO

# Optional custom upstream User-Agent.
# UPSTREAM_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:122.0) Gecko/20100101 Firefox/122.0
